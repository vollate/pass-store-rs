<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors the Vault entry sheet's passphrase step (entry_detail_sheet.dart):
     handle, title, entry path, filled field, full-width filled button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/autofill_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAutofill="noExcludeDescendants">

    <View
        android:id="@+id/autofill_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/pars_autofill_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/autofill_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/pars_autofill_sheet_background"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="invisible">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/pars_autofill_sheet_handle" />

        <TextView
            android:id="@+id/autofill_passphrase_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/autofill_passphrase_title"
            android:textColor="@color/pars_autofill_on_surface"
            android:textFontWeight="800"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/autofill_passphrase_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/pars_autofill_on_surface"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/autofill_passphrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pars_autofill_field_background"
            android:hint="@string/autofill_passphrase_label"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="@color/pars_autofill_on_surface"
            android:textColorHint="@color/pars_autofill_on_surface_variant"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/autofill_passphrase_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/pars_autofill_error"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/autofill_passphrase_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pars_autofill_button_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ProgressBar
                android:id="@+id/autofill_passphrase_progress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/pars_autofill_disabled_content"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/autofill_passphrase_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/pars_autofill_lock_open" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:duplicateParentState="true"
                android:text="@string/autofill_passphrase_unlock"
                android:textColor="@color/pars_autofill_button_content"
                android:textFontWeight="700"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
